# simple-chat Docker Compose environment variables
# Copy this file to .env and update values for your environment.
# The .env file is gitignored — do NOT commit it.

# MSSQL SA password (required)
# Must meet SQL Server complexity: 8+ chars, upper + lower + digit + symbol
MSSQL_SA_PASSWORD=SimpleChat_Dev#2026

# JWT signing secret (change in production — minimum 32 characters)
JWT_SECRET=CHANGE-THIS-IN-PRODUCTION-min-32-chars!!

# JWT access token expiry in minutes
JWT_EXPIRY_MINUTES=30

# ASP.NET Core environment (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Production

# File upload max size in MB
FILE_UPLOAD_MAX_SIZE_MB=10
